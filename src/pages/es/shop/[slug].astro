---
import type { GetStaticPaths } from "astro";
import ProductGrid from "../../../components/ProductGrid.astro";
import Storefront from "../../../layouts/Storefront.astro";
import { getCatalog, relatedProducts } from "../../../lib/catalog";
import { categoryInfo } from "../../../lib/categories";
import { formatPrice, productPath, sitePath, siteUrl, whatsappHref } from "../../../lib/site";

export const getStaticPaths = (async () => {
  const { items } = await getCatalog();
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { item, related: relatedProducts(item, items) },
  }));
}) satisfies GetStaticPaths;

const { item, related } = Astro.props;
const editorial = item.state === "editorial";
const hasDetails = item.story || item.origin || item.materials.length > 0;
const canonicalPath = productPath(item.slug);
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "NAYIRU", item: siteUrl() },
    { "@type": "ListItem", position: 2, name: "Tienda", item: siteUrl("/es/shop/") },
    { "@type": "ListItem", position: 3, name: item.title, item: siteUrl(canonicalPath) },
  ],
};
---

<Storefront
  title={`${item.title} · NAYIRU`}
  description={item.description}
  canonicalPath={canonicalPath}
  socialImage={item.image ? { path: item.image, alt: item.image_alt ?? item.title } : undefined}
  structuredData={breadcrumb}
>
  <div class="nayiru-container nayiru-product">
    <a class="nayiru-text-link nayiru-back" href={sitePath("/es/shop/")}>Volver a la tienda</a>
    <article class:list={["nayiru-product-layout", !item.image && "nayiru-product-without-photo"]}>
      {item.image && (
        <div class="nayiru-product-photo">
          <img src={sitePath(item.image)} alt={item.image_alt} fetchpriority="high" />
        </div>
      )}
      <div class="nayiru-product-copy">
        <p class="nayiru-kicker">{categoryInfo[item.category].label}</p>
        <h1>{item.title}</h1>
        <p class="nayiru-product-intro">{item.description}</p>
        {editorial && <p class="nayiru-preview-note">Pieza de referencia del diseño original.</p>}
        {!editorial && (
          <p class="nayiru-product-price">
            {item.price_ars === undefined ? "Consultar precio" : formatPrice(item.price_ars)}
            {item.sold_out && <span class="nayiru-stock">Sin stock</span>}
          </p>
        )}
        <a class="nayiru-button nayiru-button-search" href={whatsappHref(item.title)}>
          {item.sold_out ? "Consultar reposición por WhatsApp" : "Consultar por WhatsApp"}
        </a>
        {hasDetails && (
          <section class="nayiru-product-story">
            <h2>{editorial ? "La pieza de cerca" : "Historia de la pieza"}</h2>
            {item.story && <p>{item.story}</p>}
            {(item.origin || item.materials.length > 0) && (
              <dl>
                {item.origin && <div><dt>Origen</dt><dd>{item.origin}</dd></div>}
                {item.materials.length > 0 && <div><dt>Materiales</dt><dd>{item.materials.join(", ")}</dd></div>}
              </dl>
            )}
          </section>
        )}
      </div>
    </article>

    {related.length > 0 && (
      <section class="nayiru-related">
        <header class="nayiru-section-heading"><h2>También en la colección</h2></header>
        <ProductGrid items={related} />
      </section>
    )}
  </div>
</Storefront>
