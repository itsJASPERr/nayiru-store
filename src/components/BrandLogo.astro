---
import { sitePath } from "../lib/site";

interface Props {
  class?: string;
  lazy?: boolean;
}

const { class: className, lazy = false } = Astro.props;
---

<span class:list={["nayiru-logo", className]}>
  <img src={sitePath("/nayiru/logo.jpg")} width="1080" height="1080" alt="NAYIRU" loading={lazy ? "lazy" : undefined} decoding="async" />
</span>
